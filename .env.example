# Copy this file to .env and fill in real values. .env is gitignored - never commit real keys.
# Created under Cloudflare dashboard > R2 Object Storage > "Manage R2 API Tokens"
# (a separate page from the bucket's own Settings tab) - grant "Object Read & Write"
# scoped to the bucket below.

R2_ACCOUNT_ID=4732441c481f84dae15d40f5409553d2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=solo

# Website DB (MySQL) - separate database from the bot's own SQLite tracking
# DB. Only finished/public-facing data gets written here (see
# db/schema.mysql.sql and the "Website DB sync" section of server/bot.js).
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
